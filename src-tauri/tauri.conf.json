{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Tools Viewer",
  "identifier": "com.claude.tools-viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude Tools Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCQUE1QjVCQkIzRkFDQTAKUldTZ3JEKzdXMXVxcTRxNFJnYlV6Mmp3UVBaWUFzR2daQ0pnTFRJRmNGSDZNbkNnUDM4NDdXdmgK",
      "endpoints": [
        "https://github.com/StellaPolaris/peek-context/releases/latest/download/latest.json"
      ]
    }
  }
}
